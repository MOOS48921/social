{%- style -%}
  .promo-bar-{{ section.id }} {
    background-color: #8556a0;
    color: #ffffff;
    padding: {{ section.settings.padding_vertical }}px 15px;
    text-align: center;
  }
  .promo-bar-{{ section.id }} p {
    margin: 0;
    font-weight: 700;
    letter-spacing: .04em;
    line-height: 1.3;
    font-size: {{ section.settings.font_size_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    .promo-bar-{{ section.id }} p {
      font-size: {{ section.settings.font_size }}px;
    }
  }
{%- endstyle -%}
<div class="promo-bar-{{ section.id }} color-{{ section.settings.color_scheme }}">
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: none; display: block;">
      <p>{{ section.settings.text }}</p>
    </a>
  {%- else -%}
    <p>{{ section.settings.text }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Promo bar",
  "tag": "section",
  "class": "section-promo-bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "UP TO 40% OFF + FREE SHIPPING ON YOUR FIRST ORDER"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Promo bar"
    }
  ]
}
{% endschema %}
