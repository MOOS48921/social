        "faq1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Is there any alcohol or THC in Socialevia?",
            "icon": "none",
            "content": "<p>Socialevia won't get you high, and it does not give you a buzz. It does not work the way alcohol, opioids, or THC work. It turns on the happy part of your brain without making you sloppy or under the influence.</p>"
          }
        },
        "faq2": {
