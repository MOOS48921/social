    "pdp_whats_inside": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>.svwi{max-width:1000px;margin:0 auto;padding:0 20px;}.svwi-title{text-align:center;font-size:32px;font-weight:700;margin:0 0 32px;color:#121212;}.svwi-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;}.svwi-card{background:#F4ECE0;border-radius:14px;padding:26px 28px;}.svwi-name{font-size:19px;font-weight:700;color:#7C3AED;margin:0 0 8px;}.svwi-desc{font-size:15px;line-height:1.55;color:#333;margin:0;}@media screen and (max-width:749px){.svwi-grid{grid-template-columns:1fr;}}</style><div class=\"svwi\"><h2 class=\"svwi-title\">What's Inside</h2><div class=\"svwi-grid\"><div class=\"svwi-card\"><p class=\"svwi-name\">L-Theanine</p><p class=\"svwi-desc\">Calm, focused energy — takes the edge off without making you drowsy.</p></div><div class=\"svwi-card\"><p class=\"svwi-name\">GABA</p><p class=\"svwi-desc\">Quiets overthinking so you can relax into the moment.</p></div><div class=\"svwi-card\"><p class=\"svwi-name\">Taurine</p><p class=\"svwi-desc\">Smooth, steady energy that won't spike or crash.</p></div><div class=\"svwi-card\"><p class=\"svwi-name\">Ashwagandha (KSM-66®)</p><p class=\"svwi-desc\">An adaptogen that helps your body handle stress and stay balanced.</p></div></div></div>",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "pdp_swap": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>.svswap{max-width:1150px;margin:0 auto;padding:0 20px;text-align:center;}.svswap-cap{color:#7C3AED;font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:14px;margin:0 0 14px;}.svswap-title{font-size:40px;font-weight:800;text-transform:uppercase;line-height:1.1;margin:0 0 44px;color:#121212;}.svswap-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;}.svswap-col{text-align:center;}.svswap-emoji{font-size:26px;line-height:1;}.svswap-h{font-size:19px;font-weight:700;margin:10px 0 10px;color:#121212;}.svswap-d{font-size:15px;line-height:1.55;color:#444;margin:0;}@media screen and (max-width:989px){.svswap-grid{grid-template-columns:1fr 1fr;gap:34px 24px;}.svswap-title{font-size:30px;}}@media screen and (max-width:600px){.svswap-grid{grid-template-columns:1fr;}}</style><div class=\"svswap\"><p class=\"svswap-cap\">WHAT MAKES SOCIALVIA DIFFERENT</p><h2 class=\"svswap-title\">Why SocialVia Is The Perfect Swap For Booze</h2><div class=\"svswap-grid\"><div class=\"svswap-col\"><div class=\"svswap-emoji\">😌</div><p class=\"svswap-h\">Stay Calm Without Getting Sloppy</p><p class=\"svswap-d\">Relaxed and clear-headed at the same time. You stay you the whole night.</p></div><div class=\"svswap-col\"><div class=\"svswap-emoji\">⚡</div><p class=\"svswap-h\">A Social Battery That Lasts The Whole Night</p><p class=\"svswap-d\">No fading out at hour two and no crash on the way home.</p></div><div class=\"svswap-col\"><div class=\"svswap-emoji\">🍹</div><p class=\"svswap-h\">Mixes Into Anything</p><p class=\"svswap-d\">Açaí berry flavor that works in water, juice, or sparkling soda. Your drink, your way.</p></div><div class=\"svswap-col\"><div class=\"svswap-emoji\">🌅</div><p class=\"svswap-h\">Zero Hangover</p><p class=\"svswap-d\">Wake up fine, with your morning and your whole next day still yours.</p></div></div></div>",
