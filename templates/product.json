          "settings": {
            "heading": "When should I drink Socialevia?",
            "icon": "none",
            "content": "<p>Before going out. Before a date. Before a meeting. Before a dinner. Before catching up with old friends. Whenever you want to be more outgoing, relaxed, and fun around people.</p>"
