    "pdp_whats_inside": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>.svfi{max-width:1080px;margin:0 auto;padding:0 20px;}.svfi-cap{text-align:center;color:#7C3AED;font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:14px;margin:0 0 14px;}.svfi-title{text-align:center;font-size:40px;font-weight:800;text-transform:uppercase;line-height:1.1;color:#121212;margin:0 0 40px;}.svfi-panel{background:#F7F3E8;border-radius:20px;padding:36px 40px;}.svfi-layout{display:grid;grid-template-columns:0.9fr 1.1fr;gap:40px;align-items:stretch;}.svfi-media{border-radius:16px;width:100%;height:100%;min-height:420px;object-fit:cover;display:block;}.svfi-media--empty{background:#EDE7D6;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#B3A98A;font-weight:600;font-size:16px;line-height:1.6;}.svfi-list{display:flex;flex-direction:column;justify-content:center;}.svfi-item{display:flex;gap:16px;padding:18px 0;border-bottom:1px solid #E4DECB;}.svfi-item:last-child{border-bottom:none;}.svfi-num{flex:0 0 34px;width:34px;height:34px;border-radius:50%;border:2px solid #7C3AED;color:#7C3AED;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;}.svfi-name{font-size:18px;font-weight:800;text-transform:uppercase;color:#121212;margin:3px 0 7px;letter-spacing:.02em;}.svfi-desc{font-size:15px;line-height:1.5;color:#555;margin:0;}@media screen and (max-width:849px){.svfi-layout{grid-template-columns:1fr;gap:24px;}.svfi-media,.svfi-media--empty{min-height:260px;}.svfi-title{font-size:28px;}.svfi-panel{padding:24px 20px;}}</style><div class=\"svfi\"><p class=\"svfi-cap\">What's Inside?</p><h2 class=\"svfi-title\">The Formula That Calms Your Nerves And Wakes Up Your Mind</h2><div class=\"svfi-panel\"><div class=\"svfi-layout\"><div class=\"svfi-media-wrap\"><div class=\"svfi-media svfi-media--empty\">📷<br>Voeg hier je afbeelding of GIF toe</div></div><div class=\"svfi-list\"><div class=\"svfi-item\"><div class=\"svfi-num\">1</div><div><p class=\"svfi-name\">L-Theanine</p><p class=\"svfi-desc\">An amino acid from green tea that calms your nerves without making you sleepy. You feel relaxed and stay sharp at the same time.</p></div></div><div class=\"svfi-item\"><div class=\"svfi-num\">2</div><div><p class=\"svfi-name\">GABA</p><p class=\"svfi-desc\">The calming chemical your brain already makes on its own. It quiets the overthinking so you stop rehearsing what to say.</p></div></div><div class=\"svfi-item\"><div class=\"svfi-num\">3</div><div><p class=\"svfi-name\">TauroMag</p><p class=\"svfi-desc\">A form of magnesium built to reach your brain. It settles your nerves before you even walk in.</p></div></div><div class=\"svfi-item\"><div class=\"svfi-num\">4</div><div><p class=\"svfi-name\">Honokiol</p><p class=\"svfi-desc\">A magnolia bark extract that eases tension and takes the edge off — with no buzz or fog.</p></div></div><div class=\"svfi-item\"><div class=\"svfi-num\">5</div><div><p class=\"svfi-name\">Magnolol</p><p class=\"svfi-desc\">Works alongside Honokiol to keep you calm and clear without dulling you down.</p></div></div><div class=\"svfi-item\"><div class=\"svfi-num\">6</div><div><p class=\"svfi-name\">DL-Phenylalanine</p><p class=\"svfi-desc\">An amino acid your brain uses to make more dopamine. It lifts your mood and holds it up through the whole night.</p></div></div><div class=\"svfi-item\"><div class=\"svfi-num\">7</div><div><p class=\"svfi-name\">Taurine</p><p class=\"svfi-desc\">An amino acid that gives you smooth energy with zero caffeine. Your energy lasts the whole event and there's no crash after.</p></div></div><div class=\"svfi-item\"><div class=\"svfi-num\">8</div><div><p class=\"svfi-name\">Oroxylin A</p><p class=\"svfi-desc\">A rare bark extract that sharpens your focus. You stay in the conversation instead of drifting out of it.</p></div></div><div class=\"svfi-item\"><div class=\"svfi-num\">9</div><div><p class=\"svfi-name\">Rhodiola Rosea</p><p class=\"svfi-desc\">A root that helps your body handle stress. The longer you take it, the calmer you stay when things get tense.</p></div></div></div></div></div></div>",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      }
